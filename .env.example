# Honaru web. Every value is public (compiled into the site); never put a secret here.
# Local: copy to .env. Production: Cloudflare Pages build variables.

VITE_SITE_URL=https://honaru.example

# Form endpoints (POST JSON). Unset: dev fakes success, production shows the email fallback.
VITE_NEWSLETTER_ENDPOINT=
VITE_CONTACT_ENDPOINT=
