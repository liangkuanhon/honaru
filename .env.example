# Honaru API
# Local development: copy to .env (gitignored). Production: set these in the host's secret
# store. Never commit real values.

APP_ENV=development
# Comma-separated origins allowed to call the API. Production accepts https:// only.
ALLOWED_ORIGINS=http://localhost:5173, http://localhost:5174

# Supabase > Project Settings > API > Project URL. Access tokens are verified against it.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Supabase > Connect > Session pooler. Secret: contains the database password.
DATABASE_URL=
# Set to 0 only when using the transaction pooler (port 6543).
DATABASE_STATEMENT_CACHE_SIZE=100
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10

# Client values for the `docker compose up` frontend. Cloudflare Pages builds use their own
# build variables instead (see client/.env.example).
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=